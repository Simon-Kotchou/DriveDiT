# drivedit.local.env: the local machine paths of DriveDiT (DD-22). EXAMPLE ONLY: every value is a placeholder.
#
# Copy this file to one of the places tools/local_config.py and tools/launch/dd_local_config.cmd look for it,
# in this order:
#   1. the path named by DRIVEDIT_LOCAL_CONFIG (a Windows or a WSL path)
#   2. <DATA_ROOT>/config/drivedit.local.env, next to the installed tools (<DATA_ROOT>/tools)
#   3. drivedit.local.env at the root of a git checkout of this repo (gitignored), for development worktrees
# and replace every <...> with this machine's value. Never commit the copy: it is gitignored.
# tools/migrate_local_config.py writes it from the values a machine used before DD-22; check it with
#     python3 -I -B tools/local_config.py check
#
# Format: KEY=VALUE, no spaces around "=", no quotes. Paths are WSL paths (/mnt/<drive letter>/...), absolute,
# without a trailing "/"; the Windows form (<DRIVE LETTER>:\...) is derived. Values may use letters, digits, space
# and _ . , + ( ) ~ / - only.

# The capture data root: pin/, addons/, captures/, profiles, logs, reports, and the installed tools/. No spaces.
DATA_ROOT=/mnt/<data drive letter>/<data root folder>
# The planning and evidence tree; the MCP server's work root is <REALIGN_ROOT>/mcp.
REALIGN_ROOT=/mnt/<drive letter>/<planning folder>
# Local source checkouts outside this repo (third_party/dinov3).
CODE_ROOT=/mnt/<drive letter>/<code folder>
# The stable installs the launchers start, each <Steam library>/steamapps/common/<install dir>.
GAME_INSTALL=/mnt/<drive letter>/<Steam library>/steamapps/common/Arma Reforger
TOOLS_INSTALL=/mnt/<drive letter>/<Steam library>/steamapps/common/Arma Reforger Tools
# The Experimental installs (an experimental pin is for --check only).
EXPERIMENTAL_GAME_INSTALL=/mnt/<drive letter>/<Steam library>/steamapps/common/Arma Reforger Experimental
EXPERIMENTAL_TOOLS_INSTALL=/mnt/<drive letter>/<Steam library>/steamapps/common/Arma Reforger Experimental Tools
# The mount of the Windows system drive. Nothing is ever written there.
SYSTEM_DRIVE=/mnt/<system drive letter>
# The WSL distro the Windows launchers run the preflight in (wsl.exe -d <name>; wsl.exe -l -v lists them).
WSL_DISTRO=<distro name>
