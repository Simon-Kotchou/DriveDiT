# A synthetic drivedit.local.env for the tests (DD-22). Placeholder drives only: X: (data), Y: (game library) and
# Z: (system drive, Tools), so the tests never depend on, or name, a real machine.
DATA_ROOT=/mnt/x/DataRoot
REALIGN_ROOT=/mnt/x/PlanRoot
CODE_ROOT=/mnt/x/CodeRoot
GAME_INSTALL=/mnt/y/Game Library/steamapps/common/Arma Reforger
TOOLS_INSTALL=/mnt/z/Synthetic Steam (x86)/steamapps/common/Arma Reforger Tools
EXPERIMENTAL_GAME_INSTALL=/mnt/x/Experimental Library/steamapps/common/Arma Reforger Experimental
EXPERIMENTAL_TOOLS_INSTALL=/mnt/x/Experimental Library/steamapps/common/Arma Reforger Experimental Tools
SYSTEM_DRIVE=/mnt/z
WSL_DISTRO=Placeholder-Distro
