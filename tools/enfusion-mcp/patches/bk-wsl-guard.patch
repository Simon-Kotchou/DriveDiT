+/**
+ * DriveDiT local WSL patch: Workbench is a Windows process, so absolute paths the server computed
+ * in WSL form ("/mnt/c/Users/...") must reach it as drive paths ("C:/Users/..."), e.g. the
+ * absDestPath that game_duplicate / wb_entity_duplicate pass to ResourceManager.RegisterResourceFile
+ * (documented as `string absFilePath`). Only whole-string values that start with /mnt/<letter>/ are
+ * rewritten; resource paths ("Prefabs/...", "{GUID}...") are untouched.
+ */
+function toWindowsDrivePaths<T>(value: T): T {
+  if (typeof value === "string") {
+    const m = /^\/mnt\/([a-zA-Z])(\/.*)?$/.exec(value);
+    return (m ? `${m[1].toUpperCase()}:${m[2] ?? "/"}` : value) as unknown as T;
+  }
+  if (Array.isArray(value)) return value.map((v) => toWindowsDrivePaths(v)) as unknown as T;
+  if (value && typeof value === "object") {
+    const out: Record<string, unknown> = {};
+    for (const [k, v] of Object.entries(value as Record<string, unknown>)) out[k] = toWindowsDrivePaths(v);
+    return out as T;
+  }
+  return value;
+}
